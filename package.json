{
  "name": "docusign-ai-clone",
  "version": "1.0.0",
  "description": "AI-powered electronic signature platform",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cd backend && npm run dev",
    "client:dev": "cd frontend && npm start",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "start": "cd backend && npm start",
    "test": "npm test --prefix backend && npm test --prefix frontend",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "migrate:deploy": "npm run prisma:migrate:deploy --prefix backend",
    "docker:build": "docker compose build",
    "docker:start": "docker compose up --detach --no-build backend frontend",
    "start:dev": "./start-dev.sh",
    "start:prod": "./start-prod.sh"
  },
  "keywords": [
    "docusign",
    "esignature",
    "ai",
    "documents"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
