NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://docusign:replace-me@127.0.0.1:5432/docusign
JWT_SECRET=replace-with-at-least-32-random-characters
AUDIT_SIGNING_KEY=replace-with-a-different-32-character-random-secret
AUDIT_SIGNING_KEY_ID=local-2026-01
MFA_ENCRYPTION_KEY=replace-with-a-third-32-character-random-secret
REQUIRE_EMAIL_VERIFICATION=true
FRONTEND_URL=http://localhost:3000
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
S3_BUCKET=replace-me
S3_ENDPOINT=
MALWARE_SCANNER_URL=https://scanner.example.invalid/scan
MALWARE_SCANNER_HEALTH_URL=https://scanner.example.invalid/health
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=replace-with-approved-model
OPENROUTER_MODEL_VERSION=replace-with-pinned-version
OCR_ENDPOINT=https://ocr.example.invalid/v1/extract
OCR_API_KEY=replace-me
REDACTION_ENDPOINT=https://redaction.example.invalid/v1/apply
REDACTION_API_KEY=replace-me
FILING_ENDPOINT=https://filing.example.invalid/v1/file
FILING_API_KEY=replace-me
TEMPLATE_REGISTRY_ENDPOINT=https://templates.example.invalid/v1/sync
TEMPLATE_REGISTRY_API_KEY=replace-me
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
